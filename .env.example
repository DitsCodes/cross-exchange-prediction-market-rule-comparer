# --- Backend ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://rulec:rulec@db:5432/rulec

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

POLYMARKET_BASE=https://gamma-api.polymarket.com
KALSHI_BASE=https://api.elections.kalshi.com/trade-api/v2

INGEST_INTERVAL_MINUTES=30
INGEST_ON_STARTUP=false
INGEST_POLYMARKET_PAGE_SIZE=500
INGEST_KALSHI_PAGE_SIZE=200
INGEST_MAX_PAGES=20

# pg_trgm similarity score (0..1). Trigram scores run lower than embedding cosine;
# 0.18 is a pragmatic default for cross-exchange wording differences.
SIMILARITY_TOP_K=8
SIMILARITY_MIN_SCORE=0.18

ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
